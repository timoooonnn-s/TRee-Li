DELIMITERS = {"auto": None, "tab": "\t", "\\t": "\t", "semicolon": ";", "comma": ",", "pipe": "|"}


class ConfigError(Exception):
    pass


class DataError(Exception):
    pass


class Config(object):
    """Resolved settings; see tree-li.conf for documentation of every option."""


def parse_bool(value, option):
    v = value.strip().lower()
    if v in ("1", "yes", "true", "on"):
        return True
    if v in ("", "0", "no", "false", "off"):
        return False
    raise ConfigError("%s: expected yes or no, got '%s'" % (option, value))


def parse_int(value, option, lo, hi):
    try:
        n = int(value)
    except ValueError:
        raise ConfigError("%s: expected a number, got '%s'" % (option, value))
    if not lo <= n <= hi:
        raise ConfigError("%s: must be between %d and %d" % (option, lo, hi))
    return n


def parse_columns(spec):
    """'Name, aliases:Alias' -> [('Name', 'Name'), ('aliases', 'Alias')]"""
    columns = []
    for part in spec.split(","):
        key, _, label = part.partition(":")
        key, label = key.strip(), label.strip()
        if key:
            columns.append((key, label or key))
    if not columns:
        raise ConfigError("columns: at least one column is required")
    return columns


def valid_user(user):
    return bool(user) and not user.startswith("-") and re.match(r"^[^\s\x00-\x1f\x7f@]+$", user) is not None


def default_user():
    try:
        return getpass.getuser()
    except Exception:
        return os.environ.get("USER", "")


def user_config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "tree-li", CONFIG_NAME)


def load_config(args):
    """Defaults <- tree-li.conf next to the script <- ~/.config/tree-li/tree-li.conf
    <- --config FILE <- environment (TREELI_DATA) <- command line."""
    raw = dict(DEFAULTS)
    data_base = SCRIPT_DIR
    candidates = [os.path.join(SCRIPT_DIR, CONFIG_NAME), user_config_path()]
    if args.config:
        if not os.path.isfile(args.config):
            raise ConfigError("config file not found: %s" % args.config)
        candidates.append(args.config)

    cfg = Config()
    cfg.files = []
    for path in candidates:
        if not os.path.isfile(path):
            continue
        parser = configparser.ConfigParser(interpolation=None)
        try:
            with open(path, encoding="utf-8-sig") as f:
                parser.read_file(f, source=path)
        except (configparser.Error, OSError, UnicodeDecodeError) as e:
            raise ConfigError("cannot read %s: %s" % (path, e))
        if not parser.has_section(CONFIG_SECTION):
            raise ConfigError("%s: missing the [%s] section" % (path, CONFIG_SECTION))
        for key, value in parser.items(CONFIG_SECTION):
            if key not in DEFAULTS:
                raise ConfigError("%s: unknown option '%s'" % (path, key))
            raw[key] = value.strip()
            if key == "data":
                data_base = os.path.dirname(os.path.abspath(path))
        cfg.files.append(path)

    data = raw["data"] or DEFAULTS["data"]
    if os.environ.get("TREELI_DATA"):
        data, data_base = os.environ["TREELI_DATA"], os.getcwd()
    if args.data:
        data, data_base = args.data, os.getcwd()
    # Relative paths are resolved against the config file / script, never the CWD.
    cfg.data = os.path.normpath(os.path.join(data_base, os.path.expanduser(data)))

    delim = raw["delimiter"]
    if delim.lower() in DELIMITERS:
        cfg.delimiter = DELIMITERS[delim.lower()]
    elif len(delim) == 1:
        cfg.delimiter = delim
    else:
        raise ConfigError("delimiter: use auto, ';', ',', '|' or tab")

    cfg.columns = parse_columns(raw["columns"])
    cfg.host_column = raw["host_column"] or DEFAULTS["host_column"]
    cfg.name_column = raw["name_column"] or DEFAULTS["name_column"]
    cfg.user = args.user or raw["user"] or default_user()
    if cfg.user and not valid_user(cfg.user):
        raise ConfigError("user: '%s' is not a valid user name" % cfg.user)
    try:
        cfg.ssh_command = shlex.split(raw["ssh_command"]) or ["ssh"]
        cfg.ssh_options = shlex.split(raw["ssh_options"])
    except ValueError as e:
        raise ConfigError("ssh_command/ssh_options: %s" % e)
    cfg.connect_timeout = parse_int(raw["connect_timeout"], "connect_timeout", 1, 300)
    cfg.session_log = args.log or parse_bool(raw["session_log"], "session_log")
    cfg.log_dir = os.path.abspath(os.path.expanduser(raw["log_dir"]))
    cfg.ping_workers = parse_int(raw["ping_workers"], "ping_workers", 1, 256)
    cfg.ping_timeout = parse_int(raw["ping_timeout"], "ping_timeout", 1, 30)
    cfg.trace_command = raw["trace_command"] or "auto"
    return cfg


# --------------------------------------------------------------------------
# Switch list (CSV)
# --------------------------------------------------------------------------

CONTROL_CHARS = re.compile(r"[\x00-\x1f\x7f]")


def clean(value):
    return CONTROL_CHARS.sub(" ", value or "").strip()


def read_text(path):
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError as e:
        raise DataError("cannot read %s: %s" % (path, e.strerror or e))
    # UTF-8 (with or without BOM) first, then what Excel on Windows writes.
    for encoding in ("utf-8-sig", "cp1252"):
        try:
            return raw.decode(encoding)
        except UnicodeDecodeError:
            pass
    return raw.decode("latin-1")


def detect_delimiter(header_line):
    best, count = ";", 0
    for d in (";", ",", "\t", "|"):
        c = header_line.count(d)
        if c > count:
            best, count = d, c
    return best


def read_table(path, delimiter=None):
    """Return (headers, rows); every row is a dict header -> cleaned value.
    Blank lines and lines starting with '#' are ignored."""
    if not os.path.isfile(path):
        hint = ""
        if os.path.isfile(os.path.join(SCRIPT_DIR, "data.example.csv")):
            hint = " - copy data.example.csv to data.csv to start"
        raise DataError("switch list not found: %s%s" % (path, hint))
    text = read_text(path)
    first = next((line for line in text.splitlines() if line.strip()), None)
    if first is None:
        raise DataError("switch list is empty: %s" % path)
    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delimiter or detect_delimiter(first))
    headers, rows = None, []
    try:
        for record in reader:
            if not any(cell.strip() for cell in record) or record[0].lstrip().startswith("#"):
                continue
            if headers is None:
                headers, seen = [], set()
                for i, h in enumerate(record):
                    h = clean(h) or "column%d" % (i + 1)
                    while h.lower() in seen:
                        h += "_"
                    seen.add(h.lower())
                    headers.append(h)
                continue
            rows.append(dict((h, clean(record[i]) if i < len(record) else "") for i, h in enumerate(headers)))
    except csv.Error as e:
        raise DataError("%s, line %d: %s" % (path, reader.line_num, e))
    if headers is None:
        raise DataError("switch list has no header line: %s" % path)
    return headers, rows


class Device(object):
    __slots__ = ("values", "host", "name", "cells", "search")


def find_header(headers, wanted):
    wanted = wanted.strip().lower()
    for h in headers:
        if h.lower() == wanted:
            return h
    return None


def build_devices(headers, rows, cfg):
    """Return (devices, columns, warnings); columns are (header, label) pairs."""
    warns = []
    host_h = find_header(headers, cfg.host_column)
    if host_h is None:
        for alt in ("ip", "host", "hostname", "address", "ip address"):
            host_h = find_header(headers, alt)
            if host_h:
                break
    if host_h is None:
        raise DataError("no '%s' column in the switch list (found: %s)" % (cfg.host_column, ", ".join(headers)))
    name_h = find_header(headers, cfg.name_column) or headers[0]

    columns = []
    for key, label in cfg.columns:
        h = find_header(headers, key)
        if h is None:
            warns.append("column '%s' not found in the switch list" % key)
        else:
            columns.append((h, label))
    if not columns:
        columns = [(name_h, name_h), (host_h, host_h)]

    devices = []
    for row in rows:
        d = Device()
        d.values = row
        d.host = row.get(host_h, "")
        d.name = row.get(name_h, "") or d.host
        d.cells = [row.get(h, "") for h, _ in columns]
        d.search = "\x00".join(d.cells).lower()   # \x00: a token never matches across fields
        devices.append(d)
    return devices, columns, warns


def filter_devices(devices, query):
    """Whitespace separated tokens, all must match (case-insensitive substring)."""
    tokens = query.lower().split()
    if not tokens:
        return list(devices)
    return [d for d in devices if all(t in d.search for t in tokens)]


def natural_key(text):
    """'sw2' < 'sw10', '10.0.1.2' < '10.0.1.10'."""
    key = []
    for i, part in enumerate(re.split(r"([0-9]+)", text.lower())):
        if i % 2:
            key.append((0, int(part), ""))
        elif part:
            key.append((1, 0, part))
    return key


PING_RANK = {PING_DOWN: 0, PING_UP: 1, PING_WAIT: 2}


def sort_devices(devices, col, desc, ping_states):
    """col indexes the visible columns; col == len(cells) is the Ping column.
    Empty values always go last."""
    if col is None or not devices:
        return list(devices)
    if col >= len(devices[0].cells):
        def value(d):
            return ping_states.get(d.host, "")
        key = lambda d: PING_RANK.get(value(d), 9)
    else:
        def value(d):
            return d.cells[col]
        key = lambda d: natural_key(value(d))
    filled = [d for d in devices if value(d)]
    empty = [d for d in devices if not value(d)]
    return sorted(filled, key=key, reverse=desc) + empty


