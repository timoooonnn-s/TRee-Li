def check(cfg):
    """--check: validate config and switch list without starting the UI."""
    ok = True
    print("%s v%s" % (TITLE, VERSION))
    print("config files : %s" % (", ".join(cfg.files) or "none (defaults)"))
    print("switch list  : %s" % cfg.data)
    try:
        headers, rows = read_table(cfg.data, cfg.delimiter)
        devices, columns, warns = build_devices(headers, rows, cfg)
        print("switches     : %d" % len(devices))
        print("columns      : %s" % ", ".join("%s (%s)" % c for c in columns))
        bad = [d for d in devices if not valid_host(d.host)]
        for d in bad[:10]:
            print("  warning: '%s' has no usable IP/host ('%s')" % (d.name, d.host))
        if len(bad) > 10:
            print("  ... and %d more without usable IP/host" % (len(bad) - 10))
        for w in warns:
            print("  warning: %s" % w)
    except DataError as e:
        print("  ERROR: %s" % e)
        ok = False
    for name, path in (("ssh", which(cfg.ssh_command[0])), ("ping", which("ping"))):
        print("%-13s: %s" % (name, path or "NOT FOUND"))
        ok = ok and path is not None
    trace = trace_argv(cfg, "x")
    print("traceroute   : %s" % (" ".join(trace[:-1]) if trace else "NOT FOUND (traceroute/tracepath)"))
    print("session log  : %s" % (cfg.log_dir if cfg.session_log else "off"))
    return 0 if ok else 1


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tree-li", description=TITLE + " - connect to your switches over SSH.")
    parser.add_argument("--data", metavar="CSV", help="switch list (default: 'data' in tree-li.conf, else data.csv next to tree-li)")
    parser.add_argument("--config", metavar="FILE", help="additional config file")
    parser.add_argument("--user", help="pre-fill the ssh username (default: your Linux user)")
    parser.add_argument("--log", action="store_true", help="record ssh sessions to log files")
    parser.add_argument("--check", action="store_true", help="check config and switch list, then exit")
    parser.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    args = parser.parse_args(argv)

    try:
        cfg = load_config(args)
    except ConfigError as e:
        print("tree-li: config error: %s" % e, file=sys.stderr)
        return 2
    if args.check:
        return check(cfg)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("tree-li: must be run in an interactive terminal", file=sys.stderr)
        return 2

    os.environ.setdefault("ESCDELAY", "50")       # before initscr: fast ESC key
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(143))
    try:
        curses.wrapper(lambda scr: App(scr, cfg).run())
    except KeyboardInterrupt:
        pass
    except curses.error as e:
        print("tree-li: terminal error: %s (TERM=%s)" % (e, os.environ.get("TERM", "")), file=sys.stderr)
        return 1
    print("TRee-Li closed - credentials forgotten.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
