    # -- dialog windows -----------------------------------------------------

    def draw_window(self, title, subtitle, bh, bw):
        """Main screen slightly faded, then an empty framed window of bh x bw,
        centred, with the title in the top frame line.  Returns its top-left corner."""
        scr, th = self.scr, self.th
        tl, tr, bl, br, hl, vl = th.sym["box"]
        self.draw(refresh=False)
        h, w = scr.getmaxyx()
        for y in range(h):                       # fade what is behind the window
            try:
                scr.chgat(y, 0, w - 1 if y == h - 1 else -1, th.backdrop)
            except curses.error:
                pass
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        put(scr, y0, x0, tl + hl * (bw - 2) + tr, th.win_frame)
        for y in range(y0 + 1, y0 + bh - 1):
            put(scr, y, x0, vl + " " * (bw - 2) + vl, th.win_frame)
            put(scr, y, x0 + 1, " " * (bw - 2), th.win)
        put(scr, y0 + bh - 1, x0, bl + hl * (bw - 2) + br, th.win_frame)
        put(scr, y0, x0 + 2, " %s " % title, th.win_title)
        if subtitle:
            put(scr, y0, x0 + 4 + len(title), "%s %s " % (th.sym["sep"], subtitle), th.win_frame)
        return y0, x0

    # -- credentials --------------------------------------------------------

    def credential_dialog(self, error=None):
        """Ask user + password.  Returns (user, password or None) or None on ESC."""
        user, pw = self.last_user or "", ""
        field = 1 if user else 0
        scr, th, sym = self.scr, self.th, self.th.sym
        while True:
            bw, bh = min(62, scr.getmaxyx()[1] - 6), 13
            y0, x0 = self.draw_window("Login", "asked once per session", bh, bw)
            fw = max(6, bw - 18)

            values = [user, sym["mask"] * len(pw)]
            for i, label in enumerate(("Username", "Password")):
                y = y0 + 2 + i * 2
                active = field == i
                put(scr, y, x0 + 3, label, th.win_label if active else th.win)
                shown = values[i][-(fw - 2):]
                put(scr, y, x0 + 14, " " + shown.ljust(fw - 1), th.field if active else th.field_idle)
                if active:
                    put(scr, y, x0 + 15 + len(shown), " ", th.cursor)
            if error:
                for i, line in enumerate(textwrap.wrap(sym["dot"] + " " + error, bw - 6, subsequent_indent="  ")[:2]):
                    put(scr, y0 + 6 + i, x0 + 3, line, th.win_err)
            put(scr, y0 + 8, x0 + 3, ("Kept in memory only %s forgotten when TRee-Li exits" % sym["sep"])[:bw - 6],
                th.win_hint)
            put(scr, y0 + 9, x0 + 3, "Empty password: ssh asks at every login"[:bw - 6], th.win_hint)
            x = x0 + 3
            for key, label in (("Enter", "OK"), ("Tab", "next field"), ("ESC", "cancel")):
                put(scr, y0 + 11, x, key, th.win_key)
                put(scr, y0 + 11, x + len(key) + 1, label, th.win_hint)
                x += len(key) + len(label) + 4
            scr.refresh()

            key = read_key(scr, -1)
            if key is None:
                continue
            if key == "ESC":
                return None
            if key in ("TAB", "BTAB", "UP", "DOWN"):
                field = 1 - field
            elif key == "ENTER":
                if field == 0:
                    field = 1
                    continue
                if not valid_user(user):
                    error, field = "Please enter a valid username.", 0
                    continue
                self.last_user = user
                return user, (pw or None)
            elif key == "BACKSPACE":
                if field == 0:
                    user = user[:-1]
                else:
                    pw = pw[:-1]
            elif key == "CTRL_U":
                if field == 0:
                    user = ""
                else:
                    pw = ""
            elif key == "RESIZE":
                self.sync_size()
            elif len(key) == 1:
                if field == 0:
                    user += key
                else:
                    pw += key

    # -- ssh ----------------------------------------------------------------

    def connect(self, dev):
        error = None
        while True:
            if self.creds is None:
                creds = self.credential_dialog(error)
                if creds is None:
                    self.message("ssh cancelled")
                    return
                self.creds = creds
            user, password = self.creds
            result = self.run_ssh(dev, user, password)
            if result.auth_failed:
                self.creds = None             # wipe the wrong password, ask again
                error = "Login failed for '%s' on %s - please re-enter." % (user, dev.name)
                continue
            if result.hostkey_changed:
                self.message("%s: host key changed - not connected" % dev.name, error=True, seconds=15)
            elif not result.failed:
                self.state.touch(device_key(dev))
                self.refilter(dev)             # is:recent / recent order are up to date at once
                self.message("Disconnected from %s" % dev.name)
            else:
                text = "%s: ssh exit code %d" % (dev.name, result.exit_code)
                if result.last_line:
                    text += " - " + result.last_line
                self.message(text, error=True, seconds=10)
            return

    def note(self, *lines):
        """Text printed outside curses, around an ssh session: 'TRee-Li > first line', rest indented."""
        prefix = "TRee-Li"
        if self.th.colors:
            prefix = "\033[1;34m%s\033[0m" % prefix          # bold blue: every colour terminal knows it
        indent = "\r\n" + " " * 10
        return "\r\n%s %s %s" % (prefix, self.th.sym["gt"], indent.join(lines))

    def open_log(self, dev, user):
        try:
            os.makedirs(self.cfg.log_dir, mode=0o700, exist_ok=True)
            name = re.sub(r"[^A-Za-z0-9_.-]", "_", dev.name or dev.host)[:60]
            path = os.path.join(self.cfg.log_dir, "%s_%s.log" % (time.strftime("%Y%m%d-%H%M%S"), name))
            f = os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "ab")
            f.write(("# TRee-Li session log: %s (%s) as %s, %s\n"
                     % (dev.name, dev.host, user, time.strftime("%Y-%m-%d %H:%M:%S"))).encode("utf-8"))
            return f
        except OSError as e:
            os.write(sys.stdout.fileno(), self.note("cannot write session log: %s\r\n" % e).encode("utf-8", "replace"))
            return None

    def run_ssh(self, dev, user, password):
        out = sys.stdout.fileno()
        key_removed = False
        self.mouse(False)                  # the switch session gets the plain terminal
        curses.endwin()
        try:
            while True:
                argv = build_ssh_argv(self.cfg, user, dev.host, inject_password=bool(password))
                os.write(out, (self.note("Connecting to %s (%s) as %s" % (dev.name, dev.host, user),
                                         "log out to return to TRee-Li, ~. force-disconnects") + "\r\n\r\n")
                         .encode("utf-8", "replace"))
                log = self.open_log(dev, user) if self.cfg.session_log else None
                try:
                    result = run_session(argv, password, log)
                finally:
                    if log is not None:
                        log.close()
                if result.hostkey_changed and not result.auth_failed:
                    known_hosts = result.known_hosts or os.path.join(os.path.expanduser("~"), ".ssh", "known_hosts")
                    if key_removed:
                        terminal_wait_key(self.note("The host key is still reported as changed.",
                                                    "Please check %s by hand." % known_hosts,
                                                    "Press any key to return to TRee-Li ..."))
                        return result
                    answer = terminal_wait_key(self.note(
                        "The host key of %s (%s) has CHANGED." % (dev.name, dev.host),
                        "Expected if the switch was replaced - otherwise do NOT continue.",
                        "Remove the old key from %s and connect again? [y/N] " % known_hosts))
                    if answer not in (b"y", b"Y"):
                        return result
                    ok, text = remove_host_key(dev.host, known_hosts)
                    os.write(out, (text.replace("\n", "\r\n") + "\r\n").encode("utf-8", "replace"))
                    if not ok:
                        terminal_wait_key(self.note("Could not remove the old key.",
                                                    "Press any key to return to TRee-Li ..."))
                        return result
                    key_removed = True
                    continue
                if result.failed and not result.auth_failed:
                    terminal_wait_key(self.note("Connection to %s ended (exit code %d)." % (dev.name, result.exit_code),
                                                "Press any key to return to TRee-Li ..."))
                return result
        finally:
            self.resume_curses()

    def resume_curses(self):
        self.mouse(True)
        self.scr.keypad(True)
        curses.flushinp()
        self.sync_size()
        self.scr.refresh()
        self.set_cursor(False)


