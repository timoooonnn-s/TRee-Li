class App(object):

    def __init__(self, scr, cfg):
        self.scr, self.cfg = scr, cfg
        self.th = Theme(cfg.charset)
        self.devices, self.view, self.columns, self.widths = [], [], [], []
        self.cursor = self.top = self.cmd = 0
        self.body_h = 1
        self.query = ""
        self.sort_col, self.sort_desc = None, False
        self.ping = {}                 # host -> PING_UP / PING_DOWN / WAIT
        self.ssh = {}                  # host -> SSH_OPEN / SSH_CLOSED / SSH_SILENT / WAIT
        self.checked = {}              # (kind, host) -> time of that ping / SSH result
        self.headers, self.delimiter, self.issues = [], ";", []
        self.spans = {"tabs": [], "head": [], "y_tabs": -1, "y_head": -1, "y_body": -1}   # for mouse clicks
        self.found = {}                # device -> (score, {column: positions}) of fuzzy words
        self.batch = None
        self.creds = None              # (user, password or None) - memory only
        self.state = UserState(cfg.state_dir)
        self.fields = {}               # lower-case header / label -> CSV header (for field:value)
        self.last_user = cfg.user
        self.msg, self.msg_error, self.msg_until = "", False, 0
        self.load_error = None
        self.set_cursor(False)
        saved, self.checked = self.state.load_status()          # results of the last check
        self.ping, self.ssh = saved["ping"], saved["ssh"]
        self.mouse(True)
        self.load()
        if self.state.error:
            self.message(self.state.error, error=True, seconds=15)
        elif self.checked and not self.load_error and not self.issues:
            last = max(self.checked.values())
            self.message("Ping / SSH results from the last check (%s) - batch ping refreshes them"
                         % time.strftime("%Y-%m-%d %H:%M", time.localtime(last)), seconds=8)

    # -- helpers ------------------------------------------------------------

    def set_cursor(self, visible):
        try:
            curses.curs_set(1 if visible else 0)
        except curses.error:
            pass

    def message(self, text, error=False, seconds=6):
        self.msg = text
        self.msg_error = error
        self.msg_until = time.time() + seconds

    def selected(self):
        return self.view[self.cursor] if 0 <= self.cursor < len(self.view) else None

    def ncols(self):
        return len(self.columns) + len(STATUS_LABELS)

    def status(self):
        return [self.ping, self.ssh]

    def mouse(self, on):
        if not self.cfg.mouse:
            return
        try:
            curses.mousemask((CLICK | DOUBLE_CLICK | WHEEL_UP | WHEEL_DOWN) if on else 0)
            curses.mouseinterval(300)          # ms between two clicks of a double-click
        except curses.error:
            pass

    def set_status(self, kind, host, state):
        {"ping": self.ping, "ssh": self.ssh}[kind][host] = state
        self.checked[(kind, host)] = time.time()

    def save_status(self):
        self.state.save_status({"ping": self.ping, "ssh": self.ssh}, self.checked)
        if self.state.error:
            self.message(self.state.error, error=True, seconds=10)

    def load(self):
        keep = self.selected()
        try:
            report = {}
            headers, rows = read_table(self.cfg.data, self.cfg.delimiter, report)
            devices, columns, warns = build_devices(headers, rows, self.cfg)
        except DataError as e:
            self.load_error = str(e)
            self.devices = self.loaded = []
            self.columns = self.columns or list(self.cfg.columns)
            self.message(str(e), error=True, seconds=30)
        else:
            self.load_error = None
            self.devices, self.columns = devices, columns
            self.loaded = devices          # CSV order, used when sorting is switched off
            self.fields = dict((h.lower(), h) for h in headers)
            self.fields.update((label.lower(), h) for h, label in columns)
            self.headers, self.delimiter = headers, report["delimiter"]
            self.issues = data_issues(devices, report["lines"], report["issues"])
            if warns:
                self.message("; ".join(warns), error=True, seconds=15)
            elif self.issues:
                self.message("%d warning%s in the switch list - run: tree-li --check"
                             % (len(self.issues), "" if len(self.issues) == 1 else "s"), error=True, seconds=15)
        self.widths = [min(40, max([len(label) + 2] + [len(d.cells[i]) for d in self.devices]))
                       for i, (_, label) in enumerate(self.columns)]
        self.widths += STATUS_WIDTHS
        if keep is not None:
            keep = next((d for d in self.devices if d.host == keep.host and d.name == keep.name), None)
        self.apply_sort(keep)

    def apply_sort(self, keep=None):
        self.devices = sort_devices(self.loaded, self.sort_col, self.sort_desc, self.status())
        self.refilter(keep)

    def refilter(self, keep=None):
        keep = keep or self.selected()
        state = self.state
        self.found = {}
        view = filter_devices(self.devices, self.query, self.fields, {"ping": self.ping, "ssh": self.ssh},
                              state.favorites, state.recent, self.found)
        if self.sort_col is None:
            view = default_order(view, self.query, state.favorites, state.recent, self.found)
        self.view = view
        self.cursor = 0
        for i, d in enumerate(self.view):
            if d is keep:
                self.cursor = i
                break

    def set_sort(self, col, desc=None):
        """col None = original order.  Without desc: ascending -> descending -> off."""
        if col is not None and col >= self.ncols():
            return
        if desc is None:
            self.sort_col, self.sort_desc = next_sort(self.sort_col, self.sort_desc, col)
        else:
            self.sort_col, self.sort_desc = col, desc
        self.apply_sort()
        if self.sort_col is None:
            self.message("Original order")

    def status_changed(self, keep=None):
        """New ping / SSH results: keep a status sort and ping: / ssh: searches up to date."""
        if self.sort_col is not None and self.sort_col >= len(self.columns):
            self.apply_sort(keep)
        elif "ping:" in self.query.lower() or "ssh:" in self.query.lower():
            self.refilter(keep)

    def sync_size(self):
        size = terminal_size()
        if size and size != self.scr.getmaxyx():
            try:
                curses.resizeterm(*size)
            except curses.error:
                pass
        self.scr.clear()

    # -- drawing ------------------------------------------------------------
    #
    #  TRee-Li  Switch Manager                          timmy · 2/29 switches   top bar
    # ───────────────────────────────────────────────────────────────────────  rule
    #   ssh   ping   traceroute   batch ping   details   help   exit            tabs
    #   ›  ber core                                                              search
    #    NAME          IP           ...                              PING        table head
    #    ────────────────────────────────────────────────────────────────        rule
    #  ▌* ber-core-01  192.0.2.1    ...                              ● up        rows
    # ───────────────────────────────────────────────────────────────────────  rule
    #  Enter run  ←→ command  ^F favourite  F1-F6 sort  ^R reload  ^C quit       footer

    TABLE_X = 4          # column 1: selection marker, column 2: favourite star

    def layout(self):
        h, w = self.scr.getmaxyx()
        gap = 2 if h >= 22 else 1         # blank rows between the blocks when there is room
        y_tabs = 1 + gap
        y_search = y_tabs + gap
        y_head = y_search + gap
        return h, w, y_tabs, y_search, y_head

    def draw_frame(self, subtitle, right="", right_attr=None, hints=(), footer_right="", footer_attr=None,
                   show_message=True):
        """Top bar + rule, footer rule + key hints / message.  Shared by all screens."""
        scr, th, sym = self.scr, self.th, self.th.sym
        h, w = scr.getmaxyx()
        put(scr, 0, 2, "TRee-Li", th.brand)
        put(scr, 0, 11, subtitle[:max(0, w - 14 - len(right))], th.brand_sub)
        if right:
            put(scr, 0, max(0, w - len(right) - 2), right, th.info if right_attr is None else right_attr)
        put(scr, 1, 0, sym["hline"] * w, th.rule)
        put(scr, h - 2, 0, sym["hline"] * w, th.rule)

        if footer_right:
            put(scr, h - 1, max(0, w - len(footer_right) - 2), footer_right,
                th.hint if footer_attr is None else footer_attr)
        room = w - (len(footer_right) + 4 if footer_right else 2)
        if show_message and time.time() < self.msg_until:
            text = sym["dot"] + " " + self.msg
            if len(text) > room:                  # a message beats the right-hand info
                room = w - 3
                put(scr, h - 1, 0, " " * (w - 1))
            put(scr, h - 1, 2, fit(text, room, sym["more"]).rstrip(), th.err if self.msg_error else th.msg)
            return
        x = 2
        for key, label in hints:
            if x + len(key) + len(label) + 1 > room:
                break
            put(scr, h - 1, x, key, th.key)
            put(scr, h - 1, x + len(key) + 1, label, th.hint)
            x += len(key) + len(label) + 3

    def draw(self, refresh=True):
        scr, th, sym = self.scr, self.th, self.th.sym
        scr.erase()
        h, w, y_tabs, y_search, y_head = self.layout()
        if h < 10 or w < 40:
            put(scr, 0, 1, "TRee-Li", th.brand)
            put(scr, 1, 1, "Terminal too small", th.err)
            put(scr, 2, 1, "min. 40 x 10", th.hint)
            if refresh:
                scr.refresh()
            return

        right = "%d/%d switches" % (len(self.view), len(self.devices))
        if self.creds:
            right = "%s %s %s" % (self.creds[0], sym["sep"], right)
        batch = ""
        if self.batch and self.batch.running and not self.batch.cancelled:
            batch = "batch ping %d%%" % self.batch.percent
            if not self.query:
                batch += " %s ESC cancels" % sym["sep"]
        hints = [("Enter", "run"), (sym["lr"], "command"), ("^F", "favourite"),
                 ("F1-F%d" % self.ncols(), "sort"), ("^E", "export"), ("^R", "reload"), ("^C", "quit")]
        self.draw_frame("Switch Manager", right, hints=hints, footer_right=batch, footer_attr=th.wait)

        # command tabs
        spans = self.spans
        spans.update(tabs=[], head=[], y_tabs=y_tabs, y_head=y_head, y_body=y_head + 2)
        if 2 + sum(len(c) + 3 for c in COMMANDS) <= w:
            x = 2
            for i, name in enumerate(COMMANDS):
                put(scr, y_tabs, x, " %s " % name, th.tab_active if i == self.cmd else th.tab)
                spans["tabs"].append((x, x + len(name) + 2, i))
                x += len(name) + 3
        else:                                       # narrow terminal: only the selected command
            n, name = len(COMMANDS), COMMANDS[self.cmd]
            put(scr, y_tabs, 2, sym["lt"], th.tab)
            put(scr, y_tabs, 4, " %s " % name, th.tab_active)
            put(scr, y_tabs, 7 + len(name), sym["gt"], th.tab)
            spans["tabs"] = [(1, 4, (self.cmd - 1) % n), (4, 6 + len(name), self.cmd),
                             (6 + len(name), 9 + len(name), (self.cmd + 1) % n)]

        # search: "-" and "field:" parts of terms are highlighted
        put(scr, y_search, 2, sym["prompt"], th.prompt)
        shown = self.query[-(w - 9):]
        x = 5
        for part in re.split(r"(\s+)", shown):
            neg = part[:1] if len(part) > 1 and part[0] in "-'" else ""
            name, sep, value = part[len(neg):].partition(":")
            neg_attr = th.err if neg == "-" else th.key
            if sep and (name.lower() in self.fields or name.lower() in ("is", "ping", "ssh")):
                pieces = [(neg, neg_attr), (name + sep, th.key), (value, th.text)]
            else:
                pieces = [(neg, neg_attr), (part[len(neg):], th.text)]
            for text, attr in pieces:
                put(scr, y_search, x, text, attr)
                x += len(text)
        put(scr, y_search, x, " ", th.cursor)
        if not self.query:
            put(scr, y_search, 7, "type to search (fuzzy) %s 'exact  type:core  -test  ssh:closed  is:fav" % sym["sep"],
                th.placeholder)

        # table head
        x0 = self.TABLE_X
        widths = fit_widths(self.widths, w - x0 - 3 - 2 * (len(self.widths) - 1))
        table_w = sum(widths) + 2 * (len(widths) - 1)
        labels = [label for _, label in self.columns] + STATUS_LABELS
        x = x0
        for i, label in enumerate(labels):
            label = label.upper()
            put(scr, y_head, x, fit(label, widths[i], sym["more"]), th.head)
            spans["head"].append((x, x + widths[i] + 1, i))
            if i == self.sort_col and len(label) + 2 <= widths[i]:
                put(scr, y_head, x + len(label) + 1, sym["down"] if self.sort_desc else sym["up"], th.sort)
            x += widths[i] + 2
        put(scr, y_head + 1, x0, sym["hline"] * table_w, th.rule)

        # rows
        y_body = y_head + 2
        self.body_h = body_h = max(1, h - 2 - y_body)
        if self.cursor >= len(self.view):
            self.cursor = max(0, len(self.view) - 1)
        if self.cursor < self.top:
            self.top = self.cursor
        elif self.cursor >= self.top + body_h:
            self.top = self.cursor - body_h + 1
        self.top = max(0, min(self.top, max(0, len(self.view) - body_h)))

        if not self.view:
            if self.load_error:
                text, attr = self.load_error, th.err
            elif self.devices:
                text, attr = "No switch matches '%s'  %s  ESC clears the search" % (self.query, sym["sep"]), th.placeholder
            else:
                text, attr = "The switch list is empty", th.placeholder
            put(scr, y_body + 1, x0, text, attr)

        for row in range(body_h):
            idx = self.top + row
            if idx >= len(self.view):
                break
            d = self.view[idx]
            y = y_body + row
            sel = idx == self.cursor
            if sel:
                put(scr, y, 1, sym["marker"], th.marker)
                put(scr, y, 2, " " * (w - 4), th.sel)
            if device_key(d) in self.state.favorites:
                put(scr, y, 2, "*", th.fav_sel if sel else th.fav)
            x = x0
            marks = self.found.get(d, (0, {}))[1]
            for i, value in enumerate(d.cells):
                shown = fit(value, widths[i], sym["more"])
                put(scr, y, x, shown, th.sel if sel else th.text)
                visible = len(value) if len(value) <= widths[i] else widths[i] - 1
                if len(d.lcells[i]) != len(value):     # lower() changed the length: positions unreliable
                    visible = 0
                for pos in marks.get(i, ()):           # letters that matched the search
                    if pos < visible:
                        put(scr, y, x + pos, value[pos], th.match_sel if sel else th.match)
                x += widths[i] + 2
            for k, states in enumerate(self.status()):
                state = states.get(d.host)
                if state:
                    style = STATUS_STYLE.get(state, "wait") + ("_sel" if sel else "")
                    put(scr, y, x, fit("%s %s" % (sym["dot"], state), widths[len(d.cells) + k]),
                        getattr(th, style))
                x += widths[len(d.cells) + k] + 2

        # scrollbar when the list is longer than the screen
        if len(self.view) > body_h:
            thumb = max(1, body_h * body_h // len(self.view))
            pos = self.top * (body_h - thumb) // max(1, len(self.view) - body_h)
            for row in range(body_h):
                inside = pos <= row < pos + thumb
                put(scr, y_body + row, w - 1, sym["thumb"] if inside else sym["track"],
                    th.marker if inside else th.rule)
        if refresh:
            scr.refresh()

    # -- main loop ----------------------------------------------------------

    def run(self):
        while True:
            if self.batch and not self.batch.running and not self.batch.reported:
                self.batch.reported = True
                if not self.batch.cancelled:
                    self.message("Batch ping done: %s" % self.batch.summary(), seconds=20)
                self.save_status()
                self.status_changed()
            self.draw()
            key = read_key(self.scr, 250)
            if key is None:
                continue
            if self.handle(key) is False:
                if self.batch:
                    self.batch.cancel()
                self.mouse(False)
                return

    def handle(self, key):
        n = len(self.view)
        if key == "RESIZE":
            self.sync_size()
        elif key == "UP":
            self.cursor = max(0, self.cursor - 1)
        elif key == "DOWN":
            self.cursor = min(max(0, n - 1), self.cursor + 1)
        elif key == "PGUP":
            self.cursor = max(0, self.cursor - self.body_h)
        elif key == "PGDN":
            self.cursor = min(max(0, n - 1), self.cursor + self.body_h)
        elif key == "HOME":
            self.cursor = 0
        elif key == "END":
            self.cursor = max(0, n - 1)
        elif key == "LEFT":
            self.cmd = (self.cmd - 1) % len(COMMANDS)
        elif key == "RIGHT":
            self.cmd = (self.cmd + 1) % len(COMMANDS)
        elif key == "ENTER":
            return self.execute()
        elif key.startswith("F") and key[1:].isdigit():
            self.set_sort(int(key[1:]) - 1)
        elif key in ("TAB", "BTAB"):
            self.set_sort(cycle_sort(self.sort_col, self.ncols(), 1 if key == "TAB" else -1), desc=False)
        elif key == "BACKSPACE":
            if self.query:
                self.query = self.query[:-1]
                self.refilter()
        elif key == "CTRL_U":
            self.query = ""
            self.refilter()
        elif key == "CTRL_W":
            words = self.query.split()
            self.query = " ".join(words[:-1]) + (" " if len(words) > 1 else "")
            self.refilter()
        elif key == "ESC":                   # one step at a time: search, batch ping, sort
            if self.query:
                self.query = ""
                self.refilter()
            elif self.batch and self.batch.running:
                self.batch.cancel()
                self.message("Batch ping cancelled")
            elif self.sort_col is not None:
                self.set_sort(None, desc=False)
        elif key == "CTRL_F":
            dev = self.selected()
            if dev is not None:
                added = self.state.toggle_favorite(device_key(dev))
                if self.state.error:
                    self.message(self.state.error, error=True, seconds=10)
                else:
                    self.message("%s %s favourites" % (dev.name, "added to" if added else "removed from"))
                self.refilter(dev)
        elif key == "CTRL_E":
            self.export()
        elif key == "MOUSE":
            return self.click()
        elif key == "CTRL_R":
            self.load()
            if not self.load_error:
                self.message("Switch list reloaded: %d switches" % len(self.devices))
        elif key == "CTRL_L":
            self.scr.clear()
        elif len(key) == 1:
            self.query += key
            self.refilter()
        return None

    def click(self):
        """Mouse: click a tab / row to select it, double-click to run, click a column
        header to sort, wheel to scroll."""
        if not MOUSE["event"]:
            return None
        x, y, buttons = MOUSE["event"]
        spans, n = self.spans, len(self.view)
        if buttons & WHEEL_UP:
            self.cursor = max(0, self.cursor - 3)
        elif buttons & WHEEL_DOWN:
            self.cursor = min(max(0, n - 1), self.cursor + 3)
        elif buttons & (CLICK | DOUBLE_CLICK):
            double = buttons & DOUBLE_CLICK
            if y == spans["y_tabs"]:
                for x0, x1, i in spans["tabs"]:
                    if x0 <= x < x1:
                        self.cmd = i
                        return self.execute() if double else None
            elif y == spans["y_head"]:
                for x0, x1, i in spans["head"]:
                    if x0 <= x < x1:
                        self.set_sort(i)
            elif spans["y_body"] <= y < spans["y_body"] + self.body_h and self.top + y - spans["y_body"] < n:
                self.cursor = self.top + y - spans["y_body"]
                if double:
                    return self.execute()
        return None

    def export(self):
        """Ctrl-E: the current list (filter + order) with all CSV columns and the
        ping / SSH results to a new CSV file."""
        if not self.view:
            self.message("Nothing to export", error=True)
            return
        path = os.path.join(self.cfg.export_dir, "tree-li-export-%s.csv" % time.strftime("%Y%m%d-%H%M%S"))
        try:
            export_csv(path, self.view, self.headers, self.delimiter,
                       {"ping": self.ping, "ssh": self.ssh}, self.checked)
        except OSError as e:
            self.message("Export failed: %s" % (e.strerror or e), error=True, seconds=10)
            return
        self.message("Exported %d switches to %s" % (len(self.view), path), seconds=15)

    def execute(self):
        command = COMMANDS[self.cmd]
        if command == "exit":
            return False
        if command == "help":
            return self.show_help()
        if command == "batch ping":
            return self.start_batch()
        dev = self.selected()
        if dev is None:
            self.message("No switch selected", error=True)
            return None
        if command == "details":
            return self.show_details(dev)
        if not valid_host(dev.host):
            self.message("'%s' has no usable IP/host ('%s')" % (dev.name, dev.host), error=True)
            return None
        if command == "ssh":
            self.connect(dev)
        elif command == "ping":
            stream = ProcStream(ping_argv(dev.host, 4, max(2, self.cfg.ping_timeout)),
                                env=dict(os.environ, LC_ALL="C"))      # predictable English output
            self.show_text("ping %s (%s)" % (dev.name, dev.host), stream=stream)
            if stream.done:
                self.set_status("ping", dev.host, PING_UP if stream.returncode == 0 else PING_DOWN)
            elif any(" bytes from " in line for line in stream.snapshot()):
                self.set_status("ping", dev.host, PING_UP)   # closed early, but a reply came back
            else:
                return None
            self.save_status()
            self.status_changed(dev)
        elif command == "traceroute":
            argv = trace_argv(self.cfg, dev.host)
            if argv is None:
                self.message("Neither traceroute nor tracepath is installed", error=True)
            else:
                self.show_text("%s %s (%s)" % (os.path.basename(argv[0]), dev.name, dev.host),
                               stream=ProcStream(argv))
        return None

    # -- batch ping ---------------------------------------------------------

    def start_batch(self):
        if self.batch and self.batch.running and not self.batch.cancelled:
            self.message("Batch ping is already running (ESC with an empty search cancels it)")
            return
        kinds = ("ping", "ssh") if which("ping") else ("ssh",)
        hosts, seen = [], set()
        for d in self.view:
            if valid_host(d.host) and d.host not in seen:
                seen.add(d.host)
                hosts.append(d.host)
        if not hosts:
            self.message("No switches to ping", error=True)
            return
        self.batch = BatchCheck(hosts, self.cfg, {"ping": self.ping, "ssh": self.ssh}, self.checked, kinds)
        if "ping" in kinds:
            self.message("Batch ping started for %d switches (ping + SSH)" % len(hosts))
        else:
            self.message("'ping' is not installed - checking SSH only (%d switches)" % len(hosts), error=True)

    # -- popups -------------------------------------------------------------

    def show_text(self, title, lines=None, stream=None):
        """Full screen viewer.  Lines are strings (wrapped) or lists of (text, attr)
        segments (drawn as they are).  ESC / Enter / q closes; streams are stopped."""
        scr, th, sym = self.scr, self.th, self.th.sym
        offset, follow = 0, stream is not None
        try:
            while True:
                h, w = scr.getmaxyx()
                content = stream.snapshot() if stream else lines
                rows = []
                for line in content:
                    if isinstance(line, list):
                        rows.append(line)
                    else:
                        attr = th.info if line.startswith("$ ") else th.hint if line.startswith("[finished") else th.text
                        rows += [[(part, attr)] for part in wrap_lines([line], w - 5)]
                body_h = max(1, h - 5)          # top bar, rule, blank ... rule, footer
                max_off = max(0, len(rows) - body_h)
                if follow:
                    offset = max_off
                offset = max(0, min(offset, max_off))

                scr.erase()
                right, right_attr = "", None
                if stream:
                    if not stream.done:
                        right, right_attr = sym["dot"] + " running", th.wait
                    elif stream.returncode == 0:
                        right, right_attr = sym["dot"] + " done", th.up
                    else:
                        right, right_attr = "%s exit %s" % (sym["dot"], stream.returncode), th.down
                position = ""
                if len(rows) > body_h:
                    position = "%d-%d / %d" % (offset + 1, min(len(rows), offset + body_h), len(rows))
                hints = [("ESC", "close"), (sym["ud"], "scroll"), ("PgUp PgDn", "page")]
                self.draw_frame("%s %s" % (sym["gt"], title), right, right_attr, hints, position,
                                show_message=False)
                for i, segments in enumerate(rows[offset:offset + body_h]):
                    x = 3
                    for text, attr in segments:
                        put(scr, 3 + i, x, text, attr)
                        x += len(text)
                scr.refresh()

                key = read_key(scr, 150)
                if key == "MOUSE" and MOUSE["event"]:
                    buttons = MOUSE["event"][2]
                    key = "WHEEL_UP" if buttons & WHEEL_UP else "WHEEL_DOWN" if buttons & WHEEL_DOWN else None
                if key in ("ESC", "ENTER", "q", "Q"):
                    break
                elif key == "WHEEL_UP":
                    offset, follow = offset - 3, False
                elif key == "WHEEL_DOWN":
                    offset += 3
                    follow = stream is not None and offset >= max_off
                elif key == "UP":
                    offset, follow = offset - 1, False
                elif key == "DOWN":
                    offset += 1
                    follow = stream is not None and offset >= max_off
                elif key == "PGUP":
                    offset, follow = offset - body_h, False
                elif key in ("PGDN", " "):
                    offset += body_h
                    follow = stream is not None and offset >= max_off
                elif key == "HOME":
                    offset, follow = 0, False
                elif key == "END":
                    offset, follow = max_off, stream is not None
                elif key == "RESIZE":
                    self.sync_size()
        finally:
            if stream:
                stream.stop()

    def show_details(self, dev):
        th = self.th
        last = self.state.recent.get(device_key(dev))

        def result(kind, states):
            stamp = self.checked.get((kind, dev.host))
            text = states.get(dev.host, "not checked")
            return text + ("   (%s)" % time.strftime("%Y-%m-%d %H:%M", time.localtime(stamp)) if stamp else "")
        values = list(dev.values.items()) + [
            ("Ping", result("ping", self.ping)),
            ("SSH", result("ssh", self.ssh)),
            ("Favourite", "yes" if device_key(dev) in self.state.favorites else "no"),
            ("Last connected", time.strftime("%Y-%m-%d %H:%M", time.localtime(last)) if last else "never"),
        ]
        width = max(len(k) for k, _ in values)
        lines = [[(k.ljust(width), th.head), ("   ", th.text), (v, th.text)] for k, v in values]
        self.show_text("details %s %s" % (self.th.sym["sep"], dev.name), lines=lines)

